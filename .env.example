# Copy this file to .env and fill in what you need.

# Lets Jarvis answer any question with Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# What Jarvis calls you, and what you call Jarvis (this is also the wake word).
JARVIS_USER_NAME=Sri
JARVIS_NAME=Jarvis

# Optional
# JARVIS_VOICE_RATE=180
# JARVIS_NOTES_FILE=C:\Users\you\Documents\jarvis_notes.txt
# JARVIS_CLAUDE_MODEL=claude-opus-5-5
