# Copy this file to .env and fill in what you need. run.bat does the copy for you.

# Lets Jarvis chat about anything and learn from your conversations.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# What Jarvis calls you, and what you call Jarvis (this is also the wake word).
JARVIS_USER_NAME=Sri
JARVIS_NAME=Jarvis

# Voice: singsong (cute and bouncy), robot (flat and high) or normal.
JARVIS_VOICE_STYLE=singsong
# Any installed Windows voice. Zira is the high US voice; Heera is Indian English if installed.
JARVIS_VOICE=Zira
# Speed from -10 to 10.
JARVIS_VOICE_RATE=2
# Accent for speech recognition: en-IN, en-US, en-GB...
JARVIS_SPEECH_LANGUAGE=en-IN

# Email (Gmail): turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it here. Jarvis always reads
# the email back and asks "Should I send it?" before sending.
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_APP_PASSWORD=
# JARVIS_SMTP_HOST=smtp.gmail.com
# JARVIS_SMTP_PORT=465

# Even faster answers with Claude's fast mode (costs about twice as much per answer).
JARVIS_FAST_MODE=0

# Optional
# JARVIS_DATA_DIR=C:\Users\you\.jarvisbuddy
# JARVIS_CLAUDE_MODEL=claude-opus-5-5
